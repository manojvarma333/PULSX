# PulseX environment configuration. Copy to .env and adjust as needed.

# Postgres (used by docker-compose and DATABASE_URL below)
POSTGRES_USER=pulsex
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=pulsex

# Backend
DATABASE_URL=postgresql://pulsex:change-me-locally@postgres:5432/pulsex

# Frontend -> backend API base URL
VITE_API_BASE_URL=http://localhost:8000
